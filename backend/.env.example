PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=lavanderia_el_sol

JWT_SECRET=your_jwt_secret_key

# Cierre del día: hora local (0-23) a la que se liberan las máquinas que
# quedaron en uso y sus notas pasan a LISTA. Por defecto 0 (00:00).
CIERRE_HORA=0
# Zona horaria del negocio para calcular esa hora. Por defecto America/Mexico_City.
TZ_NEGOCIO=America/Mexico_City

# --- Control de máquinas por Sonoff ---
# Todas son opcionales: el default que sigue a cada una es el que se usa si no
# se define. Cuidado con dejarlas al aire "para que producción las ponga" —eso
# ya pasó con el margen de corte y nadie lo puso.
#
# Segundos que una máquina sigue con corriente DESPUÉS de cumplir su ciclo,
# antes de que se le corte. Son también los segundos en que se podría arrancar
# otra carga sin nota, así que cuanto más bajo mejor; súbelo solo si el corte
# está llegando a media carga real. Default: 10.
#SONOFF_MARGEN_CORTE_SEGUNDOS=10
# Segundos sin corriente obligatorios entre un ciclo y el siguiente de la misma
# carga. El botón "Encender máquina" espera margen de corte + esta pausa.
# Default: 10.
#SONOFF_PAUSA_OTRO_CICLO_SEGUNDOS=10
# Ciclos que puede correr una misma carga en su máquina. Default: 2.
#SONOFF_MAX_CICLOS_POR_CARGA=2
# Minutos que aguanta encendida una máquina que ya tiene corriente y espera a
# que alguien le dé "Iniciar Lavado". Default: 5.
#SONOFF_ESPERA_ARRANQUE_MINUTOS=5
# Horas que vale un encendido manual antes de caducar. Default: 3.
#SONOFF_ENCENDIDO_MANUAL_HORAS=3
# `off` desactiva SOLO el corte al terminar el ciclo, dejando el resto del
# control de Sonoff en pie. Default: activo.
#SONOFF_CORTE_CICLO=
